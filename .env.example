# URL publica del frontend
VITE_PUBLIC_APP_URL=http://localhost:5173

# Supabase publico para registro directo desde el frontend
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# WhatsApp de aterrizaje
# O defines la URL completa:
# VITE_WHATSAPP_ENTRY_URL=https://wa.me/56900000000?text=Hola
# O defines solo el numero y el front arma el enlace:
VITE_WHATSAPP_PHONE=56900000000

# Variables server-side para la API de Vercel (no usar prefijo VITE_)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
EMAIL_ENCRYPTION_KEY=tu-misma-clave-actual-del-sistema-externo
SCRAPINGBEE_API_KEY=tu-scrapingbee-api-key

# Opcionales para ScrapingBee
# SCRAPINGBEE_COUNTRY_CODE=cl
# SCRAPINGBEE_PREMIUM_PROXY=true
